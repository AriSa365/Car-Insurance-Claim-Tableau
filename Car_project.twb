      <aliases enabled='yes' />
      <column caption='Birth' datatype='date' name='[BIRTH]' role='dimension' type='ordinal' />
      <column caption='Bluebook' datatype='integer' name='[BLUEBOOK]' role='measure' type='quantitative' />
      <column caption='Car Age' datatype='integer' name='[CAR_AGE]' role='measure' type='quantitative' />
      <column caption='Car Type' datatype='string' name='[CAR_TYPE]' role='dimension' type='nominal' />
      <column caption='Car Use' datatype='string' name='[CAR_USE]' role='dimension' type='nominal' />
      <column caption='Clm Amt' datatype='integer' name='[CLM_AMT]' role='measure' type='quantitative' />
      <column caption='Clm Freq' datatype='real' datatype-customized='true' name='[CLM_FREQ]' role='dimension' type='ordinal' />
      <column caption='Car Purchase' datatype='date' datatype-customized='true' name='[Calculation_193654810358157312]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy&quot;, STR(YEAR(TODAY()) - SQRT([CAR_AGE]*[CAR_AGE])) ))' />
      </column>
      <column caption='M_Status' datatype='integer' name='[Calculation_193654811457601539]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [MSTATUS]=&apos;Yes&apos; THEN 1&#13;&#10;ELSEIF [MSTATUS]=&apos;No&apos; THEN 0&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Back' datatype='string' name='[Calculation_193654811495923716]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Back Button&quot;' />
      </column>
      <column caption='BlueBook Compare' datatype='integer' name='[Calculation_193654811528548357]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[BLUEBOOK]//MAX([Bluebook])&lt;%&gt;' />
      </column>
      <column caption='Percent Bluebook' datatype='real' name='[Calculation_193654811557675022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX({INCLUDE [ID]:MAX([BLUEBOOK])})/MAX({(MAX([BLUEBOOK]))})' />
      </column>
      <column caption='Bottom Half' datatype='integer' name='[Calculation_193654811558940687]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(1)' />
      </column>
      <column caption='Colored&lt;50%' datatype='real' name='[Calculation_193654811559239696]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF[Calculation_193654811557675022]&lt;0.5&#13;&#10;THEN [Calculation_193654811557675022]&#13;&#10;ELSE 0.5 END' />
      </column>
      <column caption='Grey&lt;50%' datatype='real' name='[Calculation_193654811559731217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_193654811557675022]&lt;0.5&#13;&#10;THEN 0.5-[Calculation_193654811557675022]&#13;&#10;END' />
      </column>
      <column caption='Colored&gt;50%' datatype='real' name='[Calculation_193654811560083474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_193654811557675022]&gt;0.5&#13;&#10;THEN [Calculation_193654811557675022]-0.5&#13;&#10;END' />
      </column>
      <column caption='Grey &gt; 50%' datatype='real' name='[Calculation_193654811560411155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_193654811557675022]&gt;0.5&#13;&#10;THEN 1-[Calculation_193654811557675022]&#13;&#10;ELSE 0.5&#13;&#10;END' />
      </column>
      <column caption='Pointer 1' datatype='real' name='[Calculation_193654811560714260]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_193654811557675022]&lt;=0.5&#13;&#10;THEN 0.005 END' />
      </column>
      <column caption='Pointer 2' datatype='real' name='[Calculation_193654811560886293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_193654811557675022]&gt;0.5&#13;&#10;THEN 0.005 END' />
      </column>
      <column caption='Dummy' datatype='string' name='[Calculation_193654811563200534]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;Dummy&apos;' />
