    <worksheet name='Proportion of Claims by Frequency'>
      <table>
        <view>
          <datasources>
            <datasource caption='Car+claims+for+insurance' name='federated.0iqjx6m0f8hq5a1g03ada1yhn27r' />
          </datasources>
          <datasource-dependencies datasource='federated.0iqjx6m0f8hq5a1g03ada1yhn27r'>
            <column caption='Car Age' datatype='integer' name='[CAR_AGE]' role='measure' type='quantitative' />
            <column caption='Car Type' datatype='string' name='[CAR_TYPE]' role='dimension' type='nominal' />
            <column caption='Clm Freq' datatype='real' datatype-customized='true' name='[CLM_FREQ]' role='dimension' type='ordinal' />
            <column caption='Car Purchase' datatype='date' datatype-customized='true' name='[Calculation_193654810358157312]' role='dimension' type='quantitative'>
              <calculation class='tableau' formula='DATE(DATEPARSE ( &quot;yyyy&quot;, STR(YEAR(TODAY()) - SQRT([CAR_AGE]*[CAR_AGE])) ))' />
            </column>
            <column caption='Claim Freq Percentile' datatype='real' name='[Calculation_989384575226478597]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([CLM_FREQ])/total(SUM([CLM_FREQ])))*100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[ID]' role='dimension' type='ordinal' />
            <column-instance column='[CLM_FREQ]' derivation='None' name='[none:CLM_FREQ:ok]' pivot='key' type='ordinal' />
