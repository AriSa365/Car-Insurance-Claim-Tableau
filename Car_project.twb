            <column caption='AGE Category' datatype='string' name='[Calculation_193654812681945142]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_821062532220198912] &gt;= 38 AND [Calculation_821062532220198912] &lt;= 54 THEN &quot;Middle-Aged Drivers&#13;&#10;(Age 38 to 54)&quot;&#13;&#10;ELSEIF [Calculation_821062532220198912] &gt;= 55 AND [Calculation_821062532220198912] &lt;= 74 THEN &quot;Senior Drivers&#13;&#10;(Age 55 to 74)&quot;&#13;&#10;ELSEIF [Calculation_821062532220198912] &gt;= 75 THEN &quot;Elderly Drivers&#13;&#10;(Age 75 and above)&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
            </column>
            <column caption='Total Claims' datatype='integer' name='[Calculation_430093789066420224]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[OLDCLAIM]+[CLM_AMT]' />
